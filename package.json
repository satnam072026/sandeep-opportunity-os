{
  "name": "sandeep-opportunity-os",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sandeep Opportunity OS — Personal Opportunity Intelligence, Research & CRM Platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/opportunity_os.test.mjs",
    "test:integration:neon": "node --test tests/neon_integration.test.mjs",
    "test:e2e": "playwright test",
    "sync:data": "node scripts/sync-data.mjs",
    "seed:supabase": "node scripts/seed-supabase.mjs",
    "seed:generate": "node scripts/generate-d1-seed.mjs",
    "db:local:setup": "npm run seed:generate && wrangler d1 migrations apply sandeep-opportunity-os --local && wrangler d1 execute sandeep-opportunity-os --local --file cloudflare/seed.sql",
    "db:remote:setup": "npm run seed:generate && wrangler d1 migrations apply sandeep-opportunity-os --remote && wrangler d1 execute sandeep-opportunity-os --remote --file cloudflare/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/serverless": "^1.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "wrangler": "^4.151.1"
  }
}

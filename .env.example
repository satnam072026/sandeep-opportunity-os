# Cloudflare Worker secrets. Set them with `wrangler secret put`; never commit values.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ADMIN_PASSWORD=replace-with-a-strong-private-password
AGENT_API_TOKEN=replace-with-a-separate-random-agent-token

# Server-side integrations used by scheduled research/sheet agents.
GOOGLE_SERVICE_ACCOUNT_EMAIL=opportunity-os-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=17NhC05g7jyTqDZRo62sGzERh9XUad4KJ8X8OBcXqb5Q
# Leave blank for same-origin Cloudflare deployment.
VITE_API_BASE_URL=
